#!/bin/bash
#MISE description="Verify the package checksum and create the GitHub release"

source "$(dirname "$0")/../../lib/release.sh"

validate_version
require_env GH_TOKEN GITHUB_REPOSITORY SOURCE_SHA
TAG="${TAG:-v$VERSION}"
DRAFT="${DRAFT:-true}"
PRERELEASE="${PRERELEASE:-false}"
[[ "$TAG" == "v$VERSION" ]] || fail "Release tag must match the version."
[[ "$SOURCE_SHA" =~ ^[a-fA-F0-9]{40}$ ]] || fail "SOURCE_SHA must be the full commit that was built."
[[ "$DRAFT" == true || "$DRAFT" == false ]] || fail "DRAFT must be true or false."
[[ "$PRERELEASE" == true || "$PRERELEASE" == false ]] || fail "PRERELEASE must be true or false."
cd "$RELEASE_DIRECTORY"
if command -v sha256sum > /dev/null; then
    sha256sum -c "Nark-${VERSION}-macOS.zip.sha256"
else
    shasum -a 256 -c "Nark-${VERSION}-macOS.zip.sha256"
fi
gh release create "$TAG" "Nark-${VERSION}-macOS.zip" "Nark-${VERSION}-macOS.zip.sha256" \
    --repo "$GITHUB_REPOSITORY" --target "$SOURCE_SHA" --title "Nark ${VERSION}" \
    --generate-notes --draft="$DRAFT" --prerelease="$PRERELEASE"
