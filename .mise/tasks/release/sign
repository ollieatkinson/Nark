#!/bin/bash
#MISE description="Import and validate Developer ID signing assets in a temporary keychain"

source "$(dirname "$0")/../../lib/release.sh"

require_env APPLE_TEAM_ID DEVELOPER_ID_P12_BASE64 DEVELOPER_ID_P12_PASSWORD APP_PROFILE_BASE64 FILTER_PROFILE_BASE64
umask 077
mkdir -p "$(dirname "$SIGNING_DIRECTORY")"
mkdir "$SIGNING_DIRECTORY" || fail "Signing directory already exists; run mise run release:clean first."
mkdir "$SIGNING_DIRECTORY/profiles"

cleanup_on_failure() {
    local status=$?
    if (( status != 0 )); then
        "$project_root/.mise/tasks/release/clean" || true
    fi
    exit "$status"
}
trap cleanup_on_failure EXIT

# Save the original search list before importing or modifying anything.
search=()
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*\"(.*)\"[[:space:]]*$ ]] || fail "Could not parse the keychain search list."
    search+=("${BASH_REMATCH[1]}")
done < <(security list-keychains -d user > "$SIGNING_DIRECTORY/keychains.txt" && cat "$SIGNING_DIRECTORY/keychains.txt")
[[ ${#search[@]} -gt 0 ]] || fail "Could not read the keychain search list."
printf '%s\0' "${search[@]}" > "$SIGNING_DIRECTORY/keychains"

keychain="$SIGNING_DIRECTORY/release.keychain-db"
password=$(openssl rand -base64 32)
if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
    printf '::add-mask::%s\n' "$password"
fi
decode_secret DEVELOPER_ID_P12_BASE64 "$SIGNING_DIRECTORY/certificate.p12"
security create-keychain -p "$password" "$keychain"
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$password" "$keychain"
security import "$SIGNING_DIRECTORY/certificate.p12" -k "$keychain" \
    -P "$DEVELOPER_ID_P12_PASSWORD" -T /usr/bin/codesign -T /usr/bin/security
rm "$SIGNING_DIRECTORY/certificate.p12"
security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$password" "$keychain" > /dev/null
security list-keychains -d user -s "$keychain" "${search[@]}"

identity=$(security find-identity -v -p codesigning "$keychain" \
    | sed -nE 's/.* ([A-F0-9]{40}) "Developer ID Application: [^"]+".*/\1/p')
[[ "$identity" =~ ^[A-F0-9]{40}$ ]] || fail "The P12 must contain one valid Developer ID Application identity."

install_profile() {
    local variable="$1" identifier="$2" name="$3"
    local source="$SIGNING_DIRECTORY/$name.provisionprofile"
    local plist="$SIGNING_DIRECTORY/$name.plist"
    local entitlements="$SIGNING_DIRECTORY/$name.json"
    local expiration expires devices uuid count index fingerprint authorized group allowed
    decode_secret "$variable" "$source"
    security cms -D -i "$source" > "$plist"
    plutil -extract Entitlements json -o "$entitlements" "$plist"
    plutil -extract TeamIdentifier json -o - "$plist" \
        | jq -e --arg team "$APPLE_TEAM_ID" '. == [$team]' > /dev/null \
        || fail "Wrong team in $name."
    jq -e --arg app "$APPLE_TEAM_ID.$identifier" '
        (."com.apple.application-identifier" // ."application-identifier") == $app
    ' "$entitlements" > /dev/null || fail "Wrong app identifier in $name."
    expiration=$(plutil -extract ExpirationDate raw -o - "$plist")
    expires=$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$expiration" '+%s')
    (( expires > $(date -u '+%s') )) || fail "The $name has expired."
    devices=$(plutil -extract ProvisionedDevices raw -o - "$plist" 2>/dev/null) || devices=0
    [[ "$devices" == 0 ]] || fail "Use a Developer ID distribution profile for $name, not a development profile."
    validate_entitlements "$entitlements" "$identifier"

    authorized=false
    count=$(plutil -extract DeveloperCertificates raw -o - "$plist")
    for ((index = 0; index < count; index++)); do
        fingerprint=$(plutil -extract "DeveloperCertificates.$index" raw -o - "$plist" \
            | base64 --decode | openssl dgst -sha1 | awk '{print toupper($NF)}')
        if [[ "$fingerprint" == "$identity" ]]; then
            authorized=true
        fi
    done
    [[ "$authorized" == true ]] || fail "The $name does not authorize the imported certificate."

    allowed=false
    while IFS= read -r group; do
        # Provisioning profiles may authorize an app-group wildcard.
        # shellcheck disable=SC2053
        if [[ group.com.ollieatkinson.Nark == $group ]]; then
            allowed=true
        fi
    done < <(jq -r '."com.apple.security.application-groups"[]?' "$entitlements")
    [[ "$allowed" == true ]] || fail "The $name does not authorize Nark's app group."

    uuid=$(plutil -extract UUID raw -o - "$plist")
    validate_uuid "$uuid"
    mkdir -p "$profiles_directory"
    if [[ -f "$profiles_directory/$uuid.provisionprofile" ]]; then
        cp -p "$profiles_directory/$uuid.provisionprofile" "$SIGNING_DIRECTORY/profiles/$uuid.backup"
    fi
    touch "$SIGNING_DIRECTORY/profiles/$uuid.installed"
    cp "$source" "$profiles_directory/$uuid.provisionprofile"
    printf '%s\n' "$uuid" > "$SIGNING_DIRECTORY/$name"
    output "$name" "$uuid"
}

install_profile APP_PROFILE_BASE64 com.ollieatkinson.Nark app_profile
install_profile FILTER_PROFILE_BASE64 com.ollieatkinson.Nark.Filter filter_profile
printf '%s\n' "$identity" > "$SIGNING_DIRECTORY/identity"
output identity "$identity"
