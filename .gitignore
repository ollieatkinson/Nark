*.provisionprofile

# Local environment overrides. Keep mise.toml and example configuration.
.env
.env.*
!.env.example
!.env.template
mise.local.toml
.mise.local.toml

# Recorded traffic and temporary output.
Recordings/
recordings/
connections.jsonl
*.log
*.tmp
.swiftformat.cache

# macOS metadata.
.DS_Store
._*
